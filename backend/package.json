{
    "name": "ar-infra-backend",
    "version": "1.0.0",
    "type": "module",
    "description": "Backend for AR Infrastructure Visualization Tool",
    "main": "src/server.js",
    "scripts": {
        "start": "node src/server.js",
        "dev": "node src/server.js",
        "lint": "eslint . --ext .js --max-warnings=0",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "prepare": "husky"
        "dev": "node src/server.js"

    },
    "keywords": [
        "AR",
        "infrastructure",
        "visualization",
        "realtime"
    ],
    "author": "",
    "license": "ISC",
    "dependencies": {
        "cors": "^2.8.6",
        "express": "^4.22.1",
        "socket.io": "^4.8.3",
        "winston": "^3.19.0"
    },
    "devDependencies": {
        "eslint": "^8.57.1",
        "eslint-config-airbnb-base": "^15.0.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-prettier": "^5.5.5",
        "husky": "^9.1.7",
        "lint-staged": "^16.2.7",
        "prettier": "^3.8.1"
    },
    "lint-staged": {
        "*.js": [
            "eslint --fix",
            "prettier --write"
        ]
    }
}